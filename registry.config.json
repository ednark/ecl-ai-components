    },
    {
      "concept": "combobox",
      "status": "deferred",
      "nearestAlternative": "select",
      "reason": "Not among the tiled ECL components"
    },
    {
      "concept": "skiplinks",
      "status": "deferred",
      "nearestAlternative": "(page markup — embed above site-header)",
      "reason": "EC/EU pages embed skip links in site markup; the header tile documents the requirement"
    }
  ],
  "staticView": {
    "css": [],
    "viewport": {
      "width": 1280,
